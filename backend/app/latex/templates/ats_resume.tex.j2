((# Jinja template with LaTeX-friendly delimiters: VAR for values, BLOCK for logic.
    Every value arrives already escaped by app/latex/renderer.py. Keep this file free of data. #))
% Generated by CV Forge — an ATS-oriented, single-column resume.
% Compiles with pdfLaTeX, XeLaTeX, LuaLaTeX or Tectonic. You can upload this file to Overleaf as-is.
\documentclass[\VAR{font_size}pt,\VAR{paper}paper]{article}
\usepackage[margin=0.75in]{geometry}
\usepackage{iftex}
\ifPDFTeX
  \usepackage[T1]{fontenc}
  \usepackage[utf8]{inputenc}
  \usepackage{lmodern}
  \input{glyphtounicode}
  \pdfgentounicode=1 % keep copied/extracted text identical to what is printed
\else
  \usepackage{fontspec}
\fi
\usepackage{enumitem}
\usepackage[hidelinks]{hyperref}
\hypersetup{pdftitle={\VAR{pdf_title}}, pdfauthor={\VAR{name}}}

\pagestyle{empty}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\raggedright
\setlist[itemize]{leftmargin=1.3em, itemsep=1pt, topsep=3pt, parsep=0pt, partopsep=0pt}

% Section heading: plain bold text with a rule underneath.
\newcommand{\cvsection}[1]{\vspace{9pt}{\large\bfseries #1}\par\vspace{2pt}\hrule\vspace{6pt}}
% Entry heading: bold text on the left, dates on the right of the same line.
\newcommand{\cvheading}[2]{\vspace{3pt}\textbf{#1}\hfill #2\par}
\newcommand{\cvsubheading}[1]{\textit{#1}\par}

\begin{document}

\begin{center}
  {\LARGE\bfseries \VAR{name}}\par
\BLOCK{ if contact_line }
  \vspace{4pt}
  \VAR{contact_line}\par
\BLOCK{ endif }
\BLOCK{ if link_line }
  \vspace{1pt}
  \VAR{link_line}\par
\BLOCK{ endif }
\end{center}
\BLOCK{ for section in sections }

\cvsection{\VAR{section.heading}}
\BLOCK{ if section.kind == "summary" }
\VAR{section.text}\par
\BLOCK{ elif section.kind == "skills" }
\BLOCK{ for group in section.groups }
\BLOCK{ if group.category }\textbf{\VAR{group.category}:} \BLOCK{ endif }\VAR{group.skills}\par
\BLOCK{ endfor }
\BLOCK{ elif section.kind == "entries" }
\BLOCK{ for entry in section.entries }
\cvheading{\VAR{entry.heading}}{\VAR{entry.dates}}
\BLOCK{ if entry.subheading }
\cvsubheading{\VAR{entry.subheading}}
\BLOCK{ endif }
\BLOCK{ if entry.link_url }
\href{\VAR{entry.link_url}}{\VAR{entry.link_text}}\par
\BLOCK{ endif }
\BLOCK{ if entry.bullets }
\begin{itemize}
\BLOCK{ for bullet in entry.bullets }
  \item \VAR{bullet}
\BLOCK{ endfor }
\end{itemize}
\BLOCK{ endif }
\BLOCK{ endfor }
\BLOCK{ elif section.kind == "list" }
\begin{itemize}
\BLOCK{ for item in section.lines }
  \item \VAR{item}
\BLOCK{ endfor }
\end{itemize}
\BLOCK{ endif }
\BLOCK{ endfor }

\end{document}
