# Copy to backend/.env and fill in. Never commit .env.

# --- AI provider (Groq) ---
# Create a key at https://console.groq.com/keys. Leave empty to run without AI tailoring.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# auto        -> strict json_schema for models known to support it, json_object otherwise
# strict      -> always response_format json_schema with strict: true
# json_object -> always JSON object mode (schema is described in the prompt, validated locally)
GROQ_STRUCTURED_MODE=auto
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=60
# Bounded retries for timeouts and 5xx only. Rate limits (429) are never retried automatically.
GROQ_MAX_RETRIES=1
GROQ_TEMPERATURE=0.2
# Includes the model's reasoning tokens, so keep this generous.
GROQ_MAX_COMPLETION_TOKENS=8192

# --- Server ---
# Keep 127.0.0.1 unless you are deliberately exposing the app on a private network (e.g. Tailscale).
CVFORGE_HOST=127.0.0.1
CVFORGE_PORT=8000
# Where uploads, generated documents and the SQLite database live. Relative paths resolve from backend/.
CVFORGE_DATA_DIR=./data
# Comma-separated browser origins allowed to call the API (only needed if you do not use the Vite proxy).
CVFORGE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional shared secret. When set, every /api request must send "Authorization: Bearer <token>".
# Set this whenever CVFORGE_HOST is not 127.0.0.1.
CVFORGE_ACCESS_TOKEN=

# --- Limits ---
CVFORGE_MAX_UPLOAD_MB=5
# Generous because Tectonic downloads its package bundle on the very first compile.
CVFORGE_COMPILE_TIMEOUT_SECONDS=300
